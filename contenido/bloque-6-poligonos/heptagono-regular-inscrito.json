  "pasos": [
    {
      "titulo": "La circunferencia y el vértice A",
      "texto": "Tenemos la circunferencia de centro O y radio 50 mm, con el punto A sobre ella.",
      "porque": "Todos los puntos de la circunferencia están a 50 mm de O.",
      "consejo": "Pincha en O con firmeza y traza la circunferencia de una sola vez.",
