  "pasos": [
    {
      "titulo": "El triángulo y el centro",
      "texto": "Tenemos el triángulo ABC y el centro de giro O. Vamos a girar cada vértice 90° alrededor de O.",
      "porque": "Un giro es un movimiento que deja fijo el centro O y mueve cada punto sobre su circunferencia.",
      "consejo": "Marca O con una cruz bien visible: es el único punto que no se mueve.",
