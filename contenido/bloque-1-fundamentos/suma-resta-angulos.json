  "pasos": [
    {
      "titulo": "Los datos",
      "texto": "Tenemos dos ángulos, uno de vértice V y otro de vértice W, y una semirrecta OE con origen en O. Hay que construir su suma y su diferencia.",
      "porque": "Para sumar ángulos hay que llevarlos a un mismo origen, con la misma abertura de compás.",
      "consejo": "Marca cada vértice con una cruz fina antes de trazar los lados.",
      "dibujo": [
        {
          "tipo": "segmento",
          "desde": "V",
          "hasta": "P",
          "estilo": "dato"
        },
        {
