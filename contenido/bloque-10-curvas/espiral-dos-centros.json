  "pasos": [
    {
      "titulo": "El segmento AB",
      "texto": "Traza el segmento AB de 8 mm. Será la distancia en la que crece la espiral en cada media vuelta.",
      "porque": "Cada media vuelta, el radio aumenta en AB: los radios son AB, 2·AB, 3·AB...",
      "consejo": "Marca A y B con una cruz fina: la espiral se trazará desde B.",
      "dibujo": [
        {
          "tipo": "segmento",
          "desde": "A",
          "hasta": "B",
          "estilo": "dato"
        },
        {
          "tipo": "punto",
          "id": "A"
        },
        {
          "tipo": "punto",
          "id": "B"
        }
      ]
    },
    {
      "titulo": "Primer arco con centro A",
      "texto": "Pincha en A con la abertura AB y traza la semicircunferencia por encima de AB, de B a P1, en el lado izquierdo de A.",
      "porque": "B está a 8 mm de A, y P1 está en el lado contrario a B, también a 8 mm de A.",
      "consejo": "Traza la semicircunferencia de una sola pasada, sin cambiar la abertura.",
      "dibujo": [
        {
          "tipo": "arcoEntre",
          "centro": "A",
          "desde": "B",
          "hasta": "P1",
